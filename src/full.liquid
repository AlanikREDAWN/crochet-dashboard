<div class="layout layout--col layout--center">
  {% comment %} <span class="title title--large">Hello, TRMNL!</span> {% endcomment %}
  <div class="outline flex flex--row flex--between gap--large w--full">
    <div class="outline">
      <div>Project Name</div>
      <div>Subtitle</div>
    </div>
    <div class="outline text--right">
      <div>Days ago started</div>
      <div>Day started</div>
    </div>
  </div>
  <div class="stretch-y outline columns">
    <div class="column outline">
      <img class="image image-dither rounded" src="https://picsum.photos/200">
    </div>
    <div class="column outline h--full">
      <div class="outline h--full">Time spent working on project</div>
      <div class="divider"></div>
      <div class="outline h--full">Row count</div>
      <div class="divider"></div>
      <div class="outline h--full">Average pace</div>
    </div>
  </div>
</div>

<div class="title_bar">
  <span class="title">Crochet Dashboard</span>
</div>
